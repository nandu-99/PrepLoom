{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/subjects/layout,_N_T_/subjects/[subjectSlug]/layout,_N_T_/subjects/[subjectSlug]/page,_N_T_/subjects/computer-networks"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/subjects/$d$subjectSlug/__PAGE__",
    "/subjects/$d$subjectSlug",
    "/subjects",
    "/_index",
    "/_head"
  ]
}