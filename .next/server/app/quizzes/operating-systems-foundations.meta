{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/quizzes/layout,_N_T_/quizzes/[quizSlug]/layout,_N_T_/quizzes/[quizSlug]/page,_N_T_/quizzes/operating-systems-foundations"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/quizzes/$d$quizSlug/__PAGE__",
    "/quizzes/$d$quizSlug",
    "/quizzes",
    "/_index",
    "/_head"
  ]
}